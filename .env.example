# ---- Server ----
PORT=3000
NODE_ENV=development
# Public URL of the site (used for share links inside the owner email)
PUBLIC_BASE_URL=http://localhost:3000

# ---- Owner notification ----
# Every successful submission is emailed here. Never exposed to the browser.
OWNER_EMAIL=owner@example.com
# Optional: display name / from address used on outgoing mail
MAIL_FROM_NAME=SuperFast Vision Board
MAIL_FROM_ADDRESS=your-email@example.com

# ---- SMTP (Nodemailer) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password

# ---- Spam protection ----
# Max submissions per IP per 15 minutes
RATE_LIMIT_MAX=5
# Minimum seconds between the page loading and the form being submitted
MIN_FILL_SECONDS=3
